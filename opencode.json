{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": ["**/.claude/**", ".claude/**/*"]
  },
  "lsp": true,
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn", "mcp"],
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "http://127.0.0.1:54623/api/mcp",
      "enabled": true,
      "oauth": false
    }
  }
}
