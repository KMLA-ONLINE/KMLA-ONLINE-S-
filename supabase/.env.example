# Edge Function secrets. Copy to `.env.dev.local` / `.env.prod.local` and upload
# with `supabase secrets set --env-file`. Values are per project, never shared.
# `SUPABASE_*` is injected by the platform; do not set it here.

# Must equal the Vault secret of the same meaning in that project's database:
# `notification_dispatch_secret` and `storage_cleanup_secret`. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NOTIFICATION_DISPATCH_SECRET=
STORAGE_CLEANUP_SECRET=

# One keypair per project; the public half also goes into that environment's
# `VITE_WEB_PUSH_VAPID_PUBLIC_KEY`. `npm run web-push:keys`.
VAPID_SUBJECT=mailto:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Without RESEND_API_KEY the dispatcher falls back to SMTP on
# `host.docker.internal`, which only resolves in the local stack.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
