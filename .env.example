# Copy to `.env.local` and fill in.
# Only VITE_-prefixed vars reach the browser bundle. In SPA mode EVERY var here
# is public by definition — never put a service_role / secret key in this file.
#
# Local stack only. Deployed values live in Vercel's Production/Preview scopes;
# Edge Function secrets in supabase/.env.example.

VITE_SUPABASE_URL=http://127.0.0.1:54621
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# Optional: 배포 원본(끝의 / 없이). 링크 미리보기 카드의 og:image를 절대 URL로 만드는
# 데만 쓴다. 비워 두면 상대 경로로 나가고, 상대 경로를 못 푸는 수집기에서만 이미지가
# 빠진다. 로컬에서는 필요 없다.
# VITE_SITE_URL=https://kmla-online.example

# Optional: point Playwright at an already-running server instead of letting it
# build and serve one. Use 127.0.0.1, not localhost (Firefox prefers ::1).
# E2E_BASE_URL=http://127.0.0.1:4173
