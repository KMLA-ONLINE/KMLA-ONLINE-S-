# Copy to `.env.local` and fill in.
# Only VITE_-prefixed vars reach the browser bundle. In SPA mode EVERY var here
# is public by definition — never put a service_role / secret key in this file.

VITE_SUPABASE_URL=http://127.0.0.1:54621
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL Playwright runs against.
E2E_BASE_URL=http://localhost:5173
